{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "igccst",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "igccst.adaripraveen.com",
      "custom_domain": true
    }
  ]
}
